# FastAPI backend configuration (copy to backend/.env)
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:8080

# Optional: point the web app at an externally hosted FastAPI service.
# When unset, the built-in prediction service is used.
VITE_API_BASE_URL=http://localhost:8000

# Never commit real secret keys. Store them as environment variables only.
